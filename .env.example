# Copy this file to .env.local and fill in the value.
# .env.local is gitignored - never commit the real ID.
#
# Where to find it: open the Google Sheet and look at the URL
#   https://docs.google.com/spreadsheets/d/<THIS PART>/edit
#
# On Vercel, set the same variable under
#   Project Settings > Environment Variables > SHEET_ID
SHEET_ID=
